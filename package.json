{
  "name": "scribetoany",
  "version": "0.1.3",
  "description": "Transcribe audio and video files into text, SRT or VTT subtitles from the command line, with ScribeToAny.",
  "keywords": [
    "transcription",
    "speech-to-text",
    "whisper",
    "subtitles",
    "srt",
    "vtt",
    "cli",
    "ai-agent"
  ],
  "homepage": "https://scribetoany.com/developers",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hypercube67-formal/scribetoany-cli.git"
  },
  "bugs": {
    "url": "https://github.com/hypercube67-formal/scribetoany-cli/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "scribetoany": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "node src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.9.0"
  }
}
